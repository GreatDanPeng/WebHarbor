# Minimal container test image for the speedo site contribution.
# Builds ONLY the speedo site + the control plane (the real image bundles
# all sites; this one exists to verify this site's container boot
# semantics: deterministic seed build -> instance_seed -> instance copy at
# boot, /reset byte-identity, /_health) without fetching the full HF asset
# tree for every other site.
FROM python:3.12-slim-bookworm

RUN pip install --no-cache-dir \
    Flask==3.1.0 Flask-SQLAlchemy==3.1.1 Flask-Login==0.6.3 \
    Flask-WTF==1.2.2 Flask-Bcrypt==1.0.1 SQLAlchemy==2.0.36 Werkzeug==3.1.3

RUN mkdir -p /opt/WebSyn
COPY sites/speedo /opt/WebSyn/speedo
COPY scripts/check_asset_inventory.py /opt/check_asset_inventory.py
COPY scripts/check_seed_databases.py /opt/check_seed_databases.py

# speedo is a build-generated-seed site (see .build-generated-seed): the
# deterministic SQLite seed is materialized from the tracked source_data
# catalog at image build, exactly like the real Dockerfile does for mta.
RUN python3 /opt/check_asset_inventory.py /opt/WebSyn/speedo
RUN cd /opt/WebSyn/speedo && rm -rf instance instance_seed __pycache__ && \
    PYTHONHASHSEED=0 python3 seed_data.py && rm -rf instance __pycache__
RUN python3 /opt/check_seed_databases.py /opt/WebSyn

COPY control_server.py /opt/control_server.py
COPY site_runner.py /opt/site_runner.py

# websyn_start.sh variant that starts only this site at its real registry
# port (40000 + index 94) so the control plane's /reset/speedo reaches it
# after the reset respawn; the contributor maps host 43095 (declared dev
# block) onto it for browsing. The real registry port is wired in
# websyn_start.sh.
RUN printf '#!/bin/bash\nset -e\nif [[ ${#WEBSYN_CONTROL_TOKEN} -lt 32 ]]; then echo "token required" >&2; exit 1; fi\nrm -rf /opt/WebSyn/speedo/instance\ncp -a /opt/WebSyn/speedo/instance_seed /opt/WebSyn/speedo/instance\npython3 /opt/site_runner.py speedo 40094 > /tmp/websyn_speedo.log 2>&1 &\necho "  speedo -> port 40094"\nsleep 12\nexec env WEBSYN_CONTROL_TOKEN="$WEBSYN_CONTROL_TOKEN" python3 /opt/control_server.py\n' > /opt/websyn_start.sh \
    && chmod +x /opt/websyn_start.sh

EXPOSE 8101 40094
CMD ["/opt/websyn_start.sh"]
