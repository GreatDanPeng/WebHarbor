# Minimal container test image for the stubhub site contribution.
# Builds ONLY the stubhub site + the control plane (the real image bundles all
# sites; this one exists to verify this site's container boot semantics:
# instance_seed -> instance copy at boot, seeding no-op, /reset byte-identity)
# without fetching the full HF asset tree for every other site.
#
# NOTE on ports: this branch registers stubhub at the tail of the SITES array
# (local index 94 -> port 40094) while the assigned declaration port is 40096
# (index 96; the audit-phase rebase normalizes the order, see the NFL
# precedent). The control plane derives a site's port from its array index, so
# the local container test must serve the LOCAL registry port for /reset to
# validate the supervisor identity record.
FROM python:3.12-slim-bookworm

RUN pip install --no-cache-dir \
    Flask==3.1.0 Flask-SQLAlchemy==3.1.1 Flask-Login==0.6.3 \
    Flask-Bcrypt==1.0.1 SQLAlchemy==2.0.36 Werkzeug==3.1.3

RUN mkdir -p /opt/WebSyn
COPY sites/stubhub /opt/WebSyn/stubhub
COPY control_server.py /opt/control_server.py
COPY site_runner.py /opt/site_runner.py
COPY scripts/check_seed_databases.py /opt/check_seed_databases.py

# websyn_start.sh variant that starts only this site (at its local registry
# port, 40000 + index 94, so the control plane's /reset/stubhub reaches it)
RUN printf '#!/bin/bash\nset -e\nif [[ ${#WEBSYN_CONTROL_TOKEN} -lt 32 ]]; then echo "token required" >&2; exit 1; fi\nrm -rf /opt/WebSyn/stubhub/instance\ncp -a /opt/WebSyn/stubhub/instance_seed /opt/WebSyn/stubhub/instance\nexec env -u WEBSYN_CONTROL_TOKEN python3 /opt/site_runner.py stubhub 40094 > /tmp/websyn_stubhub.log 2>&1 &\necho "  stubhub -> port 40094"\nsleep 12\nexec env WEBSYN_CONTROL_TOKEN="$WEBSYN_CONTROL_TOKEN" python3 /opt/control_server.py\n' > /opt/websyn_start.sh \
    && chmod +x /opt/websyn_start.sh

EXPOSE 8101 40094
CMD ["/opt/websyn_start.sh"]
